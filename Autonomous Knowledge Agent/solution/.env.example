# Copy to .env (never commit .env). Leave OPENAI_API_KEY empty to run in offline/rule-based mode.
OPENAI_API_KEY=
# Optional: OpenAI-compatible gateway (e.g. Vocareum)
OPENAI_BASE_URL=
UDAHUB_MODEL=gpt-4o-mini
# Force rule-based mode even if a key is present
UDAHUB_OFFLINE=0
UDAHUB_CONFIDENCE_THRESHOLD=0.17
